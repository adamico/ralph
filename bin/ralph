#!/usr/bin/env bash
# ralph — Ralph Wiggum loop for AFK agent-cli runs.
# Drains issues per ADR-0015 priority rules; overridable via .ralph.conf.
set -uo pipefail

usage() {
  cat <<EOF
Usage:
  ralph once [-i] [<milestone>]      # one iteration; -i runs legacy interactive mode (milestone required for github backend)
  ralph run <N> [<milestone>]        # up to N iterations, halts on COMPLETE/BLOCKED
  ralph ls [<prd|milestone>]         # list PRDs/milestones or show issue queue
  ralph status                       # inspect running iterations + suspicious processes
  ralph inspect [<milestone> [<N>]]  # list iterations or replay iteration N
  ralph recover [<milestone>]        # print recovery runbook for interrupted iteration
  ralph kill                         # pkill ralph + stop sandbox
EOF
  exit 1
}

# Threshold (seconds CPU time) above which a sandbox child process is
# flagged as suspicious — typical hung dragonruby/lint runs.
STUCK_CPU_SECS="${STUCK_CPU_SECS:-180}"

# --- defaults ---------------------------------------------------------
AGENT_CLI="${AGENT_CLI:-}"
AGENT_CMD="${AGENT_CMD:-}"
AGENT_ARGS="${AGENT_ARGS:-}"
CLAUDE_CMD="${CLAUDE_CMD:-}"
MARKER_FILE=".scratch/ACTIVE"
TEST_CMD="./run_tests"
LINT_CMD="/lint"
MODEL="${MODEL:-}"
MODEL_CLASS="${MODEL_CLASS:-low}"

# Backend: 'fs' (default, .scratch/<active>/issues/*.md) or 'github'.
BACKEND="${BACKEND:-fs}"
# GitHub backend knobs (used only when BACKEND=github).
GH_REPO="${GH_REPO:-}"                    # optional; defaults to gh-detected repo
GH_LABEL_READY="${GH_LABEL_READY:-ready-for-agent}"
GH_LABEL_BLOCKED="${GH_LABEL_BLOCKED:-blocked}"
LEGACY_CLAUDE_CMD_WARNED=0
RESOLVED_AGENT_CLI=""
RESOLVED_AGENT_CMD=""
RESOLVED_AGENT_ARGS=""
RESOLVED_MODEL=""
RESOLVED_MODEL_SOURCE=""
RESOLVED_MODEL_CLASS=""
RESOLVED_MODEL_DISPLAY=""

pick_next_issue() {
  # ADR-0015: lowest filename with a ready Status AND every Blocked-by
  # is 'Status: done'. Echoes path or empty. Sets ALL_BLOCKED=1 if
  # unfinished issues remain but none pickable.
  #
  # Ready vocabulary mirrors the github backend (GH_LABEL_READY, default
  # 'ready-for-agent'): both 'ready' and 'ready-for-agent' are accepted so
  # the fs backend stays in sync with what the triage/to-issues skills emit.
  local prd_dir="$1"
  local issues_dir="$prd_dir/issues"
  ALL_BLOCKED=0
  local any_unfinished=0 pick=""
  for f in "$issues_dir"/*.md; do
    [ -e "$f" ] || continue
    local status
    status=$(grep -m1 '^Status:' "$f" | awk '{print $2}')
    [ "$status" = "done" ] && continue
    any_unfinished=1
    case "$status" in
      ready|ready-for-agent) ;;
      *) continue ;;
    esac
    local bbline deps_ok=1
    bbline=$(grep -m1 '^Blocked-by:' "$f" | sed 's/^Blocked-by:[[:space:]]*//')
    # 'none' (any case) is prose for "no dependencies", same as empty.
    [ "$(printf '%s' "$bbline" | tr '[:upper:]' '[:lower:]')" = "none" ] && bbline=""
    if [ -n "$bbline" ]; then
      IFS=',' read -ra deps <<< "$bbline"
      for d in "${deps[@]}"; do
        d=$(echo "$d" | tr -d '[:space:]')
        [ -z "$d" ] && continue
        local dep_file="$issues_dir/$d.md"
        if [ ! -f "$dep_file" ] || ! grep -q '^Status: done' "$dep_file"; then
          deps_ok=0; break
        fi
      done
    fi
    if [ "$deps_ok" = 1 ]; then pick="$f"; break; fi
  done
  if [ -z "$pick" ] && [ "$any_unfinished" = 1 ]; then ALL_BLOCKED=1; fi
  echo "$pick"
}

gh_args() {
  # Emit common gh flags (repo scope) for use via `$(gh_args)`.
  [ -n "$GH_REPO" ] && printf -- '--repo %s ' "$GH_REPO"
}

infer_milestone_gh() {
  # Infer a single open milestone, or error/prompt if ambiguous.
  # Returns milestone title on success, or empty + exit code on error.
  # Exit codes: 0 = success, 1 = error (0 or >1 milestones, non-TTY), 2 = user cancelled picker
  local repo_flag=""
  [ -n "$GH_REPO" ] && repo_flag="--repo $GH_REPO"

  local milestones_json
  # shellcheck disable=SC2086
  milestones_json=$(gh api $repo_flag repos/:owner/:repo/milestones?state=open 2>/dev/null | jq -r '.[] | .title') || {
    echo "ralph: failed to fetch milestones" >&2
    return 1
  }

  local count
  count=$(printf '%s\n' "$milestones_json" | grep -c . || true)

  if [ "$count" -eq 0 ]; then
    echo "ralph: no open milestones; create one or run gh issue create --milestone <name>" >&2
    return 1
  elif [ "$count" -eq 1 ]; then
    printf '%s' "$milestones_json"
    return 0
  else
    # Multiple milestones — check if stdin is a TTY
    if [ -t 0 ]; then
      # Interactive picker. Prompts MUST go to stderr: this function is
      # always called via $(infer_milestone_gh), so anything on stdout is
      # captured as the return value (invisible menu + a read that blocks
      # with no visible prompt = silent hang). Only the chosen title is stdout.
      local i=1
      printf '\nMultiple open milestones:\n' >&2
      printf '%s\n' "$milestones_json" | while read -r m; do
        printf '%d) %s\n' "$i" "$m" >&2
        i=$((i+1))
      done
      printf '\nSelect milestone (1-%d): ' "$count" >&2
      read -r choice
      if ! [[ "$choice" =~ ^[0-9]+$ ]] || [ "$choice" -lt 1 ] || [ "$choice" -gt "$count" ]; then
        echo "ralph: invalid choice" >&2
        return 2
      fi
      printf '%s\n' "$milestones_json" | sed -n "${choice}p"
      return 0
    else
      # Non-TTY — error with candidates
      echo "ralph: multiple open milestones (specify one):" >&2
      printf '%s\n' "$milestones_json" | sed 's/^/  /'  >&2
      return 1
    fi
  fi
}

close_milestone_gh() {
  # Close the GitHub milestone after the queue drains. Failure is non-fatal.
  local milestone="$1"
  local repo_flag=""
  [ -n "$GH_REPO" ] && repo_flag="--repo $GH_REPO"

  local milestone_num
  # shellcheck disable=SC2086
  milestone_num=$(gh api $repo_flag "repos/:owner/:repo/milestones" \
    --jq ".[] | select(.title == \"$milestone\") | .number" 2>/dev/null)
  if [ -z "$milestone_num" ]; then
    echo "ralph: warning: could not resolve milestone number for '$milestone'; skipping auto-close" >&2
    return 0
  fi
  # shellcheck disable=SC2086
  if gh api $repo_flag "repos/:owner/:repo/milestones/$milestone_num" \
       -X PATCH -f state=closed >/dev/null 2>&1; then
    echo "ralph: milestone '$milestone' closed."
  else
    echo "ralph: warning: failed to close milestone '$milestone' (permissions?)" >&2
  fi
  return 0
}

pick_next_issue_gh() {
  # GitHub backend variant. Echoes picked issue number, or empty.
  # Sets ALL_BLOCKED=1 if open issues remain in the milestone but none
  # pickable (every ready issue has an undone Blocked-by).
  # Done == issue closed. Blocked-by entries in the issue body header
  # reference issues as "#NN" (comma-separated).
  local milestone="$1"
  ALL_BLOCKED=0
  local repo_flag=""
  [ -n "$GH_REPO" ] && repo_flag="--repo $GH_REPO"

  # All open issues in milestone, sorted ascending by number.
  local open_json
  # shellcheck disable=SC2086
  open_json=$(gh issue list $repo_flag --milestone "$milestone" --state open \
              --json number,labels,body --limit 200 2>/dev/null) || { echo ""; return 0; }
  local any_open
  any_open=$(printf '%s' "$open_json" | jq 'length')
  [ "${any_open:-0}" = 0 ] && { echo ""; return 0; }

  # Iterate readies in ascending number order.
  local readies
  readies=$(printf '%s' "$open_json" | jq -r --arg L "$GH_LABEL_READY" '
    map(select(.labels | map(.name) | index($L))) | sort_by(.number) | .[].number')

  local pick=""
  local num
  for num in $readies; do
    local body deps_line deps_ok=1
    body=$(printf '%s' "$open_json" | jq -r --argjson n "$num" \
            '.[] | select(.number==$n) | .body')
    deps_line=$(printf '%s\n' "$body" | grep -m1 -i '^Blocked-by:' | \
                sed 's/^[Bb]locked-by:[[:space:]]*//')
    if [ -n "$deps_line" ]; then
      local IFS=','
      for d in $deps_line; do
        d=$(printf '%s' "$d" | tr -d '[:space:]#')
        [ -z "$d" ] && continue
        local dstate
        # shellcheck disable=SC2086
        dstate=$(gh issue view "$d" $repo_flag --json state -q .state 2>/dev/null)
        if [ "$dstate" != "CLOSED" ]; then deps_ok=0; break; fi
      done
    fi
    if [ "$deps_ok" = 1 ]; then pick="$num"; break; fi
  done
  if [ -z "$pick" ]; then ALL_BLOCKED=1; fi
  echo "$pick"
}

build_prompt_gh() {
  local milestone="$1" issue_num="$2"
  cat <<EOF
GitHub backend. Milestone: $milestone. Picked issue: #$issue_num.

Follow these priority rules (ADR-0015 style). Do not ask questions — act.

1. Read issue #$issue_num via 'gh issue view $issue_num --json number,title,body,state,labels,milestone,comments' for the spec.
2. Implement it. The test oracle (ADR-0008 model B) only sees PUSHED state, so the
   ONLY valid sequence is: implement -> commit -> push -> run tests via: $TEST_CMD.
   Then run lint via: $LINT_CMD. Never claim tests pass before you have pushed; a
   green from before your push reflects stale origin, not your work (false green).
3. If tests are red after a push, diagnose and repair the failing tests in this iteration.
   Commit + push the repair and re-run tests. Red pushed tests are the feedback loop;
   do not create a separate issue or mark this issue blocked because tests are red.
4. Treat lint separately from tests. If lint repair is focused and in-scope, fix it here,
   commit + push, and re-run lint. If lint repair is broad, risky, or outside this issue's scope, create a separate lint remediation issue
   in milestone '$milestone' with the '$GH_LABEL_READY' label and enough detail for HITL or another ralph session,
   and mention that follow-up issue in the completion comment.
5. On success (tests green AFTER your push, and lint either green or split into a separate
   remediation issue): close the issue with a comment summarizing the result and any lint
   follow-up issue, append a one-paragraph entry to progress.txt, commit + push (code + progress).
6. Only use the failure/blocked path for genuine external blockers
   (for example: missing dependency, impossible/contradictory acceptance criteria, unavailable
   service, or a defect outside this issue's scope that you cannot safely fix here). Then roll
   the branch back to the iteration baseline so origin is green again — 'git reset --hard <baseline>
   && git push --force-with-lease' where <baseline> is the SHA recorded at the start of
   this iteration (per ADR-0009; 'ralph recover' prints it). This drops your red commits,
   leaving NO red/WIP commits on origin.
   Then 'gh issue edit $issue_num --add-label "$GH_LABEL_BLOCKED" --remove-label "$GH_LABEL_READY"'
   and 'gh issue comment $issue_num --body "Blocked-reason: <why>"'.
   Leave the working tree clean and in sync with origin so the next iteration can start.
7. If no ready issues remain in milestone '$milestone' but some are still open,
   output <promise>BLOCKED</promise> and stop.
8. If every issue in milestone '$milestone' is closed, output
   <promise>COMPLETE</promise> and stop.
EOF
}

read_active_marker() {
  if [ ! -s "$MARKER_FILE" ]; then
    echo "ralph: no active PRD in $MARKER_FILE. Stopping." >&2
    return 10
  fi
  local active
  active=$(head -1 "$MARKER_FILE" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
  if [ -z "$active" ]; then
    echo "ralph: ACTIVE marker is empty. Stopping." >&2
    return 1
  fi
  if echo "$active" | grep -qE '[/[:blank:]]'; then
    echo "ralph: ACTIVE marker malformed (expected a single feature dirname, got: '$active'). Stopping." >&2
    return 1
  fi
  echo "$active"
}

build_prompt() {
  local prd_dir="$1" issues_dir="$2"
  cat <<EOF
@$prd_dir/PRD.md @$issues_dir @progress.txt

Follow these priority rules (ADR-0015 style). Do not ask questions — act.

1. Scan $issues_dir/*.md headers. Pick the next issue: lowest filename
   whose 'Status: ready' AND every entry in 'Blocked-by:' is 'Status: done'.
2. If no such issue exists but unfinished issues remain (all blocked),
   output <promise>BLOCKED</promise> and stop.
3. If every issue has 'Status: done', clear $MARKER_FILE (write empty
   file) and output <promise>COMPLETE</promise>.
4. Otherwise implement the picked issue. The test oracle (ADR-0008 model B) only
   sees PUSHED state, so the ONLY valid sequence is: implement -> commit -> push
   -> run tests via: $TEST_CMD. Then run lint via: $LINT_CMD. Never claim tests
   pass before you have pushed; a green from before your push reflects stale origin
   (false green).
5. If tests are red after a push, diagnose and repair the failing tests in this iteration.
   Commit + push the repair and re-run tests. Red pushed tests are the feedback loop;
   do not create a separate issue or mark this issue blocked because tests are red.
6. Treat lint separately from tests. If lint repair is focused and in-scope, fix it here,
   commit + push, and re-run lint. If lint repair is broad, risky, or outside this issue's scope, create a separate lint remediation issue
   under $issues_dir with 'Status: ready', enough detail for HITL or another ralph session,
   and mention that follow-up issue in progress.txt.
7. On success (tests green AFTER your push, and lint either green or split into a separate
   remediation issue): set its header 'Status: done', append a one-paragraph entry to
   progress.txt, commit + push (issue file + code + progress). Do NOT write to
   $MARKER_FILE — it is ralph-owned state. Progress notes go in progress.txt only.
8. Only use the failure/blocked path for genuine external blockers
   (for example: missing dependency, impossible/contradictory acceptance criteria, unavailable
   service, or a defect outside this issue's scope that you cannot safely fix here). Then roll
   the branch back to the iteration baseline SHA so origin is green again (git reset --hard
   <baseline> + force-with-lease push; per ADR-0009, 'ralph recover' prints it),
   then edit the issue header to 'Status: blocked', add a 'Blocked-reason:' line, and
   commit + push that header change with a [blocked] prefix. Leave the working tree
   clean and in sync with origin so the next iteration can start.
EOF
}

record_baseline() {
  # Write iteration baseline to .ralph-logs/<scope>/baseline containing:
  #   sha=<HEAD commit SHA>
  #   issue=<issue identifier>
  #   branch=<current branch name>
  #   timestamp=<unix timestamp>
  # Overwrites on each iteration (only latest matters).
  local scope="$1" issue_id="$2"
  local logs_dir=".ralph-logs/$scope"
  local baseline_file="$logs_dir/baseline"

  # Ensure the scope dir exists — record_baseline runs before the
  # non-interactive path's mkdir, so on the first iteration of a fresh
  # scope the dir is otherwise absent and the write would fail silently.
  mkdir -p "$logs_dir" || { echo "ralph: failed to create logs directory" >&2; return 1; }

  local sha branch ts
  sha=$(git rev-parse HEAD)
  branch=$(git branch --show-current)
  ts=$(date +%s)

  cat > "$baseline_file" <<EOF
sha=$sha
issue=$issue_id
branch=$branch
timestamp=$ts
EOF
}

read_baseline() {
  # Parse iteration baseline from .ralph-logs/<scope>/baseline.
  # Sets global variables: BASELINE_SHA, BASELINE_ISSUE, BASELINE_BRANCH, BASELINE_TIMESTAMP.
  # Returns 0 on success, 1 if file missing.
  local scope="$1"
  local baseline_file=".ralph-logs/$scope/baseline"

  if [ ! -f "$baseline_file" ]; then
    return 1
  fi

  # Parse key=value lines (do NOT source — the file holds untrusted
  # branch/issue strings that must not be evaluated as shell).
  _bl_val() { grep -m1 "^$1=" "$baseline_file" | cut -d= -f2-; }
  BASELINE_SHA=$(_bl_val sha)
  BASELINE_ISSUE=$(_bl_val issue)
  BASELINE_BRANCH=$(_bl_val branch)
  # shellcheck disable=SC2034
  BASELINE_TIMESTAMP=$(_bl_val timestamp)
  unset -f _bl_val

  return 0
}

recovery_plan() {
  # Generate ordered list of commands to redo an interrupted iteration from scratch.
  # Pure function: no git invocation, no network, no filesystem writes.
  # Takes: baseline_sha (HEAD before interrupted iteration), milestone, issue, branch
  # Returns: text list of commands in order (never includes 'main', uses branch verbatim)
  local baseline_sha="$1" milestone="$2" issue="$3" branch="$4"

  cat <<EOF
git reset --hard $baseline_sha
git clean -fdx
git push --force-with-lease origin $branch
ralph run 1 $milestone
EOF
}

warn_legacy_claude_cmd_once() {
  if [ "$LEGACY_CLAUDE_CMD_WARNED" -eq 0 ]; then
    echo "ralph: warning: CLAUDE_CMD is deprecated; prefer AGENT_CLI=claude with AGENT_CMD." >&2
    LEGACY_CLAUDE_CMD_WARNED=1
  fi
}

resolve_agent_cli_config() {
  local cli="${AGENT_CLI:-}"
  local cmd="${AGENT_CMD:-}"
  local args="${AGENT_ARGS:-}"
  local legacy_cmd="${CLAUDE_CMD:-}"

  if [ -n "$cmd" ] && [ -z "$cli" ]; then
    echo "ralph: AGENT_CMD is set but AGENT_CLI is missing" >&2
    return 1
  fi

  if [ -z "$cmd" ]; then
    if [ -n "$legacy_cmd" ] && { [ -z "$cli" ] || [ "$cli" = "claude" ]; }; then
      cmd="$legacy_cmd"
      cli="claude"
      warn_legacy_claude_cmd_once
    elif [ -z "$cli" ]; then
      cli="claude"
      cmd="claude"
    else
      cmd="$cli"
    fi
  fi

  if [ -z "$cli" ]; then
    cli="claude"
  fi

  case "$cli" in
    claude|codex|pi|antigravity) ;;
    *)
      echo "ralph: unsupported AGENT_CLI '$cli' (expected: claude, codex, pi, antigravity)" >&2
      return 1
      ;;
  esac

  RESOLVED_AGENT_CLI="$cli"
  RESOLVED_AGENT_CMD="$cmd"
  RESOLVED_AGENT_ARGS="$args"
  return 0
}

resolve_model_config() {
  local cli="$1"
  local model_class="${MODEL_CLASS:-low}"

  # shellcheck disable=SC2034
  RESOLVED_MODEL_CLASS="$model_class"

  if [ -n "${MODEL:-}" ]; then
    RESOLVED_MODEL="$MODEL"
    RESOLVED_MODEL_SOURCE="explicit"
    RESOLVED_MODEL_DISPLAY="$MODEL (explicit)"
    return 0
  fi

  case "$model_class" in
    low) ;;
    *)
      echo "ralph: unsupported MODEL_CLASS '$model_class' (expected: low)" >&2
      return 1
      ;;
  esac

  case "$cli" in
    claude)
      RESOLVED_MODEL="sonnet"
      RESOLVED_MODEL_SOURCE="model-class:$model_class"
      RESOLVED_MODEL_DISPLAY="sonnet (MODEL_CLASS=$model_class default)"
      ;;
    codex)
      RESOLVED_MODEL="gpt-5.4-mini"
      RESOLVED_MODEL_SOURCE="model-class:$model_class"
      RESOLVED_MODEL_DISPLAY="gpt-5.4-mini (MODEL_CLASS=$model_class default)"
      ;;
    pi)
      RESOLVED_MODEL=""
      # shellcheck disable=SC2034
      RESOLVED_MODEL_SOURCE="provider-default"
      RESOLVED_MODEL_DISPLAY="provider default (MODEL_CLASS=$model_class; ralph omits --model)"
      ;;
    antigravity)
      RESOLVED_MODEL="Gemini 3.5 Flash (Low)"
      # shellcheck disable=SC2034
      RESOLVED_MODEL_SOURCE="model-class:$model_class"
      RESOLVED_MODEL_DISPLAY="Gemini 3.5 Flash (Low)"
      ;;
  esac
  return 0
}

agent_model_manifest_value() {
  printf '%s' "$RESOLVED_MODEL_DISPLAY"
}

# --- load project config ---------------------------------------------
SANDBOX_NAME=""
# shellcheck disable=SC1091
[ -f ./.ralph.conf ] && . ./.ralph.conf

# Auto-derive sandbox name from the configured command if not set:
# `sbx run <name>` or `sbx run claude --` (default name pattern is
# claude-<workdir>). Prefer AGENT_CMD when present; otherwise fall back
# to CLAUDE_CMD for legacy configs.
_sandbox_cmd="${AGENT_CMD:-${CLAUDE_CMD:-}}"
if [ -z "$SANDBOX_NAME" ] && [[ "$_sandbox_cmd" == *"sbx run"* ]]; then
  arg=$(echo "$_sandbox_cmd" | awk '{for (i=1;i<=NF;i++) if ($i=="run") {print $(i+1); exit}}')
  if [ "$arg" = "claude" ] || [ -z "$arg" ]; then
    SANDBOX_NAME="claude-$(basename "$PWD")"
  else
    SANDBOX_NAME="$arg"
  fi
fi
unset _sandbox_cmd

cmd_status() {
  # sbx exec attaches to the terminal and leaves it in raw mode (no
  # ONLCR), so any later echo stair-steps. Capture sandbox output
  # first, restore tty, THEN print.
  local host_ps sbx_out=""
  host_ps=$(pgrep -fl 'ralph (once|run)|afk-ralph' || echo "(none)")
  if [ -n "$SANDBOX_NAME" ]; then
    sbx_out=$(sbx exec "$SANDBOX_NAME" -- ps -eo pid,etime,time,comm,args </dev/null 2>/dev/null)
    # Force CR-on-LF + cooked mode back on. sbx exec leaves the tty
    # raw (no onlcr) regardless of what zsh had set before.
    if [ -t 1 ]; then
      stty sane 2>/dev/null || true
    fi
  fi

  echo "--- host ralph processes ---"
  echo "$host_ps"
  echo
  if [ -n "$SANDBOX_NAME" ]; then
    echo "--- sandbox '$SANDBOX_NAME' processes ---"
    echo "$sbx_out" | awk -v thr="$STUCK_CPU_SECS" '
      NR==1 {print; next}
      {
        split($3, t, ":");
        secs = (length(t)==3 ? t[1]*3600+t[2]*60+t[3] : t[1]*60+t[2]);
        if ($4 ~ /dragonruby|rubocop|ruby|node/) {
          mark = (secs >= thr) ? "  [STUCK?]" : "";
          print $0 mark;
        }
      }'
    echo
    echo "(processes flagged [STUCK?] have used >${STUCK_CPU_SECS}s CPU)"
  else
    echo "(no SANDBOX_NAME — set in .ralph.conf to inspect sandbox)"
  fi

  # Detect interrupted iterations (dead PID + baseline present)
  if [ -d ".ralph-logs" ]; then
    local any_interrupted=0
    for scope_dir in .ralph-logs/*/; do
      [ -d "$scope_dir" ] || continue
      local scope
      scope=$(basename "$scope_dir")
      local running_file baseline_file
      running_file="$scope_dir/running"
      baseline_file="$scope_dir/baseline"

      # Check if both running and baseline files exist
      if [ -f "$running_file" ] && [ -f "$baseline_file" ]; then
        local pid
        pid=$(cat "$running_file" 2>/dev/null)
        # A non-numeric/empty PID is a corrupt marker — treat as dead.
        # Otherwise kill -0 returns 0 if the process exists, 1 if not.
        if ! [[ "$pid" =~ ^[0-9]+$ ]] || ! kill -0 "$pid" 2>/dev/null; then
          # PID is dead; read baseline
          if read_baseline "$scope"; then
            if [ "$any_interrupted" = 0 ]; then
              echo
              echo "--- INTERRUPTED iterations (dead PID + baseline) ---"
              any_interrupted=1
            fi
            printf "  scope: %-30s  issue: #%-4s  branch: %s\n" "$scope" "$BASELINE_ISSUE" "$BASELINE_BRANCH"
          fi
        fi
      fi
    done
  fi
}

cmd_kill() {
  pkill -f 'ralph (once|run)|afk-ralph' && echo "ralph processes killed"
  if [ -n "$SANDBOX_NAME" ]; then
    sbx stop "$SANDBOX_NAME" 2>&1
  fi
}

extract_issue_from_jsonl() {
  # Extract issue number from JSONL file (parse from prompt or comments)
  local log_file="$1"
  # Look for "Picked issue: #NN" or similar patterns in assistant text
  # grep -oE (POSIX/BSD-portable; macOS grep lacks -P/\K)
  jq -r 'select(.type == "assistant").message.content[]? | select(.type == "text").text' < "$log_file" \
    | grep -oE 'Picked issue: #[0-9]+' | grep -oE '[0-9]+' | head -1 || echo ""
}

iteration_final_message_file() {
  local log_file="$1"
  printf '%s\n' "${log_file%.jsonl}.final.txt"
}

extract_claude_final_message_from_jsonl() {
  # Extract the last assistant text message from Claude stream-json output.
  local log_file="$1"
  jq -rs '
    map(
      select(.type == "assistant")
      | [(.message.content // [])[] | select(.type == "text") | .text]
      | join("\n")
      | select(length > 0)
    )
    | last // empty
  ' < "$log_file"
}

stream_claude_jsonl_pretty() {
  jq -r '
    if .type == "assistant" then
      .message.content[]? | (
        if .type == "text" then .text
        elif .type == "tool_use" then "→ " + .name + " " + (((.input // {}) | tostring)[0:140])
        else empty end)
    elif .type == "result" then "● " + (.subtype // "result")
    else empty end
    | select(. != "") | gsub("\n"; "\r\n") | . + "\r\n\n"'
}

stream_codex_jsonl_pretty() {
  jq -r '
    if .type == "item.completed" and .item.type == "agent_message" then
      .item.text // empty
    elif .type == "item.started" and .item.type == "command_execution" then
      "→ " + (.item.command // "command")
    elif .type == "item.completed" and .item.type == "command_execution" then
      "● command exit " + ((.item.exit_code // .item.exitCode // 0) | tostring)
    elif .type == "item.completed" and .item.type == "web_search" then
      "→ web_search"
    elif .type == "item.completed" and .item.type == "mcp_tool_call" then
      "→ mcp " + (.item.server // "") + "/" + (.item.tool // "")
    elif .type == "item.completed" and .item.type == "plan_update" then
      "→ plan updated"
    else empty end
    | select(. != "") | gsub("\n"; "\r\n") | . + "\r\n\n"'
}

stream_pi_jsonl_pretty() {
  jq -r '
    if .type == "message_update" and .assistantMessageEvent.type == "text_delta" then
      .assistantMessageEvent.delta // empty
    elif .type == "tool_execution_start" then
      "→ " + (.toolName // "tool") + " " + (((.args // {}) | tostring)[0:140])
    elif .type == "tool_execution_end" then
      if .isError then
        "● " + (.toolName // "tool") + " error"
      else
        "● " + (.toolName // "tool") + " done"
      end
    elif .type == "auto_retry_start" then
      "→ auto-retry " + ((.attempt // 0) | tostring) + "/" + ((.maxAttempts // 0) | tostring)
    elif .type == "compaction_start" then
      "→ compaction " + (.reason // "manual")
    else empty end
    | select(. != "") | gsub("\n"; "\r\n") | . + "\r\n\n"'
}

extract_pi_final_message_from_jsonl() {
  # Prefer canonical final assistant message events; fall back to reconstructing
  # the last assistant text stream from text_delta events when those are absent.
  local log_file="$1"
  jq -rs '
    def text_from_content:
      [(.content // [])[] | select(.type == "text") | .text] | join("\n");
    def canonical_text($event):
      if $event.type == "message_end" then
        ($event.message // {})
      elif $event.type == "turn_end" then
        ($event.message // {})
      elif $event.type == "message_update" and (($event.assistantMessageEvent.type // "") == "done") then
        ($event.assistantMessageEvent.message // {})
      else
        {}
      end
      | select((.role // "") == "assistant")
      | text_from_content
      | select(length > 0);
    def delta_text($segments):
      $segments
      | sort_by(.idx)
      | map(.text)
      | join("");

    reduce .[] as $event (
      {canonical: [], current: {active: false, segments: []}, fallback: []};
      if $event.type == "message_start" then
        if (($event.message.role // "") == "assistant") then
          .current = {active: true, segments: []}
        else
          .current = {active: false, segments: []}
        end
      elif $event.type == "message_update" and .current.active and (($event.assistantMessageEvent.type // "") == "text_delta") then
        .current.segments += [{
          idx: ($event.assistantMessageEvent.contentIndex // 0),
          text: ($event.assistantMessageEvent.delta // "")
        }]
      elif $event.type == "message_end" then
        if .current.active then
          .fallback += [delta_text(.current.segments)]
        else
          .
        end
        | .current = {active: false, segments: []}
        | .canonical += [canonical_text($event)]
      elif $event.type == "agent_end" then
        if .current.active then
          .fallback += [delta_text(.current.segments)]
        else
          .
        end
        | .current = {active: false, segments: []}
      elif $event.type == "turn_end" then
        .canonical += [canonical_text($event)]
      elif $event.type == "message_update" and (($event.assistantMessageEvent.type // "") == "done") then
        .canonical += [canonical_text($event)]
      else
        .
      end
    )
    | ((.canonical | map(select(length > 0)) | last) // (.fallback | map(select(length > 0)) | last) // empty)
  ' < "$log_file"
}

write_final_message_artifact() {
  local agent_cli="$1" log_file="$2" final_file="$3"

  case "$agent_cli" in
    claude)
      extract_claude_final_message_from_jsonl "$log_file" > "$final_file"
      ;;
    codex)
      [ -f "$final_file" ] || {
        echo "ralph: codex did not write final message artifact: $final_file" >&2
        return 1
      }
      ;;
    pi)
      extract_pi_final_message_from_jsonl "$log_file" > "$final_file"
      ;;
    *)
      echo "ralph: no final-message writer for AGENT_CLI=$agent_cli" >&2
      return 1
      ;;
  esac
}

extract_promise_from_final_message_file() {
  local final_file="$1"
  [ -f "$final_file" ] || return 0

  local result
  result=$(cat "$final_file")
  if [[ "$result" == *"<promise>COMPLETE</promise>"* ]]; then
    echo "COMPLETE"
  elif [[ "$result" == *"<promise>BLOCKED</promise>"* ]]; then
    echo "BLOCKED"
  else
    echo ""
  fi
}

extract_promise_from_iteration_artifacts() {
  # Prefer the adapter's final-message artifact; fall back to legacy JSONL
  # result parsing so existing logs remain inspectable.
  local log_file="$1"
  local final_file promise result

  final_file=$(iteration_final_message_file "$log_file")
  promise=$(extract_promise_from_final_message_file "$final_file")
  if [ -n "$promise" ]; then
    echo "$promise"
    return 0
  fi

  result=$(jq -r 'select(.type == "result").result // empty' < "$log_file")
  if [[ "$result" == *"<promise>COMPLETE</promise>"* ]]; then
    echo "COMPLETE"
  elif [[ "$result" == *"<promise>BLOCKED</promise>"* ]]; then
    echo "BLOCKED"
  else
    echo ""
  fi
}

cmd_inspect_list() {
  # List all iterations in a scope
  local scope="$1"
  local logs_dir=".ralph-logs/$scope"

  if [ ! -d "$logs_dir" ]; then
    echo "ralph: no logs found for scope '$scope'"
    return 0
  fi

  local any_iters=0
  printf 'Iterations in %s:\n' "$scope"
  printf '%6s  %-19s  %7s  %s\n' "Iter#" "Timestamp" "Promise" "Issue"
  printf '%6s  %s  %s  %s\n' "-----" "-------------------" "-------" "-----"

  # bash 3 compat (no mapfile) and set -u safe (guard empty array)
  local files=()
  local f
  # shellcheck disable=SC2012
  while IFS= read -r f; do
    [ -n "$f" ] && files+=("$f")
  done < <(ls -1 "$logs_dir"/iter-* 2>/dev/null | sort -V)

  [ ${#files[@]} -eq 0 ] || for log_file in "${files[@]}"; do
    [ -e "$log_file" ] || continue
    any_iters=1

    local basename
    basename=$(basename "$log_file")
    # Extract iteration number from iter-N-timestamp
    local iter_num
    # shellcheck disable=SC2001
    iter_num=$(echo "$basename" | sed 's/iter-\([0-9]*\)-.*/\1/')

    # Extract timestamp from filename (second component)
    local ts
    # shellcheck disable=SC2001
    ts=$(echo "$basename" | sed 's/iter-[0-9]*-\([0-9]*\).jsonl/\1/')
    if [ -n "$ts" ] && [ "$ts" != "$basename" ]; then
      # Convert Unix timestamp to readable format
      ts=$(date -d "@$ts" '+%Y-%m-%d %H:%M:%S' 2>/dev/null || echo "$ts")
    fi

    local promise issue
    promise=$(extract_promise_from_iteration_artifacts "$log_file")
    issue=$(extract_issue_from_jsonl "$log_file")

    printf '%6s  %-19s  %7s  %s\n' "$iter_num" "$ts" "$promise" "${issue:-—}"
  done

  if [ "$any_iters" = 0 ]; then
    echo "(no iterations logged)"
  fi
  return 0
}

cmd_inspect_replay() {
  # Replay a specific iteration
  local scope="$1" iter_num="$2"
  local logs_dir=".ralph-logs/$scope"

  if [ ! -d "$logs_dir" ]; then
    echo "ralph: no logs found for scope '$scope'"
    return 1
  fi

  # Find the log file for this iteration
  local log_file
  # shellcheck disable=SC2012
  log_file=$(ls "$logs_dir"/iter-"$iter_num"-* 2>/dev/null | head -1)
  if [ -z "$log_file" ] || [ ! -f "$log_file" ]; then
    echo "ralph: iteration $iter_num not found in $logs_dir"
    return 1
  fi

  # Extract promise result for header
  local promise
  promise=$(extract_promise_from_iteration_artifacts "$log_file")
  local issue
  issue=$(extract_issue_from_jsonl "$log_file")

  echo "=== Iteration $iter_num (Issue #${issue:-?}) ==="
  [ -n "$promise" ] && echo "Promise: $promise"
  echo

  # Apply stream_text filter to display clean output
  jq -r 'select(.type == "assistant").message.content[]? | select(.type == "text").text // empty' < "$log_file"

  return 0
}

cmd_inspect_tail() {
  # Live-tail mode: stream current iteration until session ends
  local scope="$1"
  local logs_dir=".ralph-logs/$scope"
  local running_file="$logs_dir/running"

  if [ ! -d "$logs_dir" ]; then
    echo "ralph: no logs found for scope '$scope'"
    return 1
  fi

  if [ ! -f "$running_file" ]; then
    echo "ralph: no running session in scope '$scope'"
    return 1
  fi

  echo "ralph: tailing live session in '$scope'..."
  echo

  # Use temp dir for state tracking (bash 3 compat: no associative arrays)
  local state_dir
  state_dir=$(mktemp -d)
  trap 'rm -rf "$state_dir"' RETURN

  while [ -f "$running_file" ]; do
    # bash 3 compat: glob instead of mapfile
    local current_iter
    for current_iter in "$logs_dir"/iter-* ; do
      [ -e "$current_iter" ] || continue

      # Extract iteration number
      local iter_num
      iter_num=$(basename "$current_iter" | sed 's/iter-\([0-9]*\)-.*/\1/')

      local hdr_file="$state_dir/hdr_$iter_num"
      local lines_file="$state_dir/lines_$iter_num"
      local promise_file="$state_dir/promise_$iter_num"

      # Print iteration boundary marker on first entry for this iteration
      if [ ! -f "$hdr_file" ]; then
        local issue
        issue=$(extract_issue_from_jsonl "$current_iter")
        echo "=== Iteration $iter_num (Issue #${issue:-?}) ==="
        touch "$hdr_file"
      fi

      # Count current JSONL lines in this iteration
      local current_jsonl_lines
      current_jsonl_lines=$(grep -c . < "$current_iter" 2>/dev/null || echo 0)
      local last_lines=0
      [ -f "$lines_file" ] && last_lines=$(cat "$lines_file")

      # If new lines were added, process them
      if [ "$current_jsonl_lines" -gt "$last_lines" ]; then
        sed -n "$((last_lines + 1)),\$p" < "$current_iter" \
          | jq -r 'select(.type == "assistant").message.content[]? | select(.type == "text").text // empty' 2>/dev/null || true
        echo "$current_jsonl_lines" > "$lines_file"
      fi

      # Check if iteration has completed and we haven't printed promise yet
      if [ ! -f "$promise_file" ]; then
        local promise
        promise=$(extract_promise_from_iteration_artifacts "$current_iter")
        if [ -n "$promise" ]; then
          echo "Promise: $promise"
          echo
          touch "$promise_file"
        fi
      fi
    done

    # Brief sleep to avoid busy-waiting
    sleep 0.1
  done

  echo "ralph: session ended."
  return 0
}

cmd_inspect() {
  # Inspect logged iterations: list mode, tail mode, or replay mode
  local milestone="${1:-}" iter_num="${2:-}"

  local scope
  if [ "$BACKEND" = "github" ]; then
    # Infer milestone if not provided
    if [ -z "$milestone" ]; then
      milestone=$(infer_milestone_gh)
      rc=$?
      if [ $rc -ne 0 ]; then
        return "$rc"
      fi
    fi
    scope="$milestone"
  else
    # Filesystem backend: infer from marker or use provided
    if [ -z "$milestone" ]; then
      if [ -s "$MARKER_FILE" ]; then
        milestone=$(tr -d '[:space:]' < "$MARKER_FILE")
      else
        echo "ralph: no active PRD in $MARKER_FILE. Provide explicit scope." >&2
        return 1
      fi
    fi
    scope="$milestone"
  fi

  # Dispatch based on mode
  if [ -z "$iter_num" ]; then
    # List/tail mode: check for running session
    local running_file=".ralph-logs/$scope/running"
    if [ -f "$running_file" ]; then
      # Live session detected: enter tail mode
      cmd_inspect_tail "$scope"
    else
      # No running session: enter list mode
      cmd_inspect_list "$scope"
    fi
  else
    # Replay mode
    if ! [[ "$iter_num" =~ ^[0-9]+$ ]]; then
      echo "ralph: iteration number must be a non-negative integer" >&2
      return 1
    fi
    cmd_inspect_replay "$scope" "$iter_num"
  fi
}

# --- ls subcommand ---------------------------------------------------
ls_prds() {
  local active=""
  [ -s "$MARKER_FILE" ] && active=$(tr -d '[:space:]' < "$MARKER_FILE")
  local found=0
  for d in .scratch/*/; do
    [ -d "$d" ] || continue
    local name
    name=$(basename "$d")
    [ "$name" = "ACTIVE" ] && continue
    found=1
    if [ "$name" = "$active" ]; then
      printf '* %s\n' "$name"
    else
      printf '  %s\n' "$name"
    fi
  done
  [ "$found" = 0 ] && echo "(no PRDs in .scratch/)"
  return 0
}

ls_milestones() {
  local repo_flag=""
  [ -n "$GH_REPO" ] && repo_flag="--repo $GH_REPO"
  command -v gh >/dev/null 2>&1 || { echo "ralph: 'gh' CLI not found" >&2; return 1; }
  command -v jq >/dev/null 2>&1 || { echo "ralph: 'jq' not found" >&2; return 1; }
  local repo_path
  if [ -n "$GH_REPO" ]; then
    repo_path="$GH_REPO"
  else
    repo_path=$(gh repo view --json nameWithOwner -q .nameWithOwner 2>/dev/null)
  fi
  gh api "repos/$repo_path/milestones?state=open&per_page=100" 2>/dev/null \
    | jq -r '.[] | "\(.title)\t\(.open_issues)\t\(.closed_issues)"' \
    | while IFS=$'\t' read -r title open closed; do
        printf '  %-50s  %s open, %s closed\n' "$title" "$open" "$closed"
      done
}

ls_issues_fs() {
  local prd="$1"
  local prd_dir=".scratch/$prd"
  if [ ! -d "$prd_dir/issues" ]; then
    echo "ralph: PRD '$prd' not found in .scratch/" >&2; return 1
  fi
  local next_pick
  next_pick=$(pick_next_issue "$prd_dir")
  printf 'PRD: %s\n' "$prd"
  local any_unfinished=0
  for f in "$prd_dir/issues"/*.md; do
    [ -e "$f" ] || continue
    local name status bbline marker="  "
    name=$(basename "$f")
    status=$(grep -m1 '^Status:' "$f" | awk '{print $2}')
    bbline=$(grep -m1 '^Blocked-by:' "$f" | sed 's/^Blocked-by:[[:space:]]*//')
    local title
    title=$(grep -v '^Status:\|^Blocked-by:\|^---' "$f" | grep -m1 '.' | sed 's/^#* *//')
    [ "$status" != "done" ] && any_unfinished=1
    [ "$f" = "$next_pick" ] && marker="→ "
    local extra=""
    [ -n "$bbline" ] && extra=" [Blocked-by: $bbline]"
    printf '%s%-8s %s  %s%s\n' "$marker" "${status:-?}" "$name" "$title" "$extra"
  done
  if [ -z "$next_pick" ]; then
    [ "$any_unfinished" = 1 ] \
      && echo "(all blocked — human needed)" \
      || echo "(complete)"
  fi
  return 0
}

ls_issues_gh() {
  local milestone="$1"
  command -v gh >/dev/null 2>&1 || { echo "ralph: 'gh' CLI not found" >&2; return 1; }
  command -v jq >/dev/null 2>&1 || { echo "ralph: 'jq' not found" >&2; return 1; }
  local repo_flag=""
  [ -n "$GH_REPO" ] && repo_flag="--repo $GH_REPO"

  ALL_BLOCKED=0
  local next_pick all_blocked_val
  # pick_next_issue_gh runs in a subshell; capture ALL_BLOCKED via a temp file
  local _ab_tmp
  _ab_tmp=$(mktemp)
  next_pick=$(pick_next_issue_gh "$milestone"; echo "$ALL_BLOCKED" > "$_ab_tmp")
  all_blocked_val=$(cat "$_ab_tmp"); rm -f "$_ab_tmp"

  local open_json closed_json
  # shellcheck disable=SC2086
  open_json=$(gh issue list $repo_flag --milestone "$milestone" --state open \
              --json number,title,labels,body --limit 200 2>/dev/null) || open_json="[]"
  # shellcheck disable=SC2086
  closed_json=$(gh issue list $repo_flag --milestone "$milestone" --state closed \
                --json number,title --limit 200 2>/dev/null) || closed_json="[]"

  local n_open n_closed
  n_open=$(printf '%s' "$open_json" | jq 'length')
  n_closed=$(printf '%s' "$closed_json" | jq 'length')
  printf 'Milestone: %s  (%s open, %s closed)\n' "$milestone" "$n_open" "$n_closed"

  printf '%s' "$closed_json" | jq -r 'sort_by(.number) | .[] | "\(.number)\t\(.title)"' \
    | while IFS=$'\t' read -r num title; do
        printf '  closed   #%-4s %s\n' "$num" "$title"
      done

  # encode body as base64 to survive newlines in the tab-delimited stream
  printf '%s' "$open_json" | jq -r --arg L "$GH_LABEL_READY" --arg B "$GH_LABEL_BLOCKED" \
    'sort_by(.number) | .[] | "\(.number)\t\(.title)\t\(.labels | map(.name) | join(","))\t\(.body | @base64)"' \
    | while IFS=$'\t' read -r num title labels body_b64; do
        local marker="  " st bbextra=""
        [ "$num" = "$next_pick" ] && marker="→ "
        local body
        body=$(printf '%s' "$body_b64" | base64 -d 2>/dev/null)
        if printf '%s' "$labels" | grep -qF "$GH_LABEL_BLOCKED"; then
          st="blocked "
          local bb
          bb=$(printf '%s\n' "$body" | grep -m1 -i '^Blocked-by:' | sed 's/^[Bb]locked-by:[[:space:]]*//')
          [ -n "$bb" ] && bbextra=" [Blocked-by: $bb]"
        elif printf '%s' "$labels" | grep -qF "$GH_LABEL_READY"; then
          st="ready   "
        else
          st="open    "
        fi
        printf '%s%s #%-4s %s%s\n' "$marker" "$st" "$num" "$title" "$bbextra"
      done

  if [ -z "$next_pick" ]; then
    [ "$all_blocked_val" = 1 ] \
      && echo "(all blocked — human needed)" \
      || echo "(complete)"
  fi
}

cmd_recover() {
  # Print recovery runbook for an interrupted iteration from baseline.
  # Print-only: never executes git push --force-with-lease.
  local milestone="${1:-}"

  if [ "$BACKEND" = "github" ]; then
    command -v gh >/dev/null 2>&1 || { echo "ralph: 'gh' CLI not found" >&2; return 1; }
    command -v jq >/dev/null 2>&1 || { echo "ralph: 'jq' not found" >&2; return 1; }

    # Infer milestone if not provided
    if [ -z "$milestone" ]; then
      milestone=$(infer_milestone_gh)
      rc=$?
      if [ $rc -ne 0 ]; then
        return "$rc"
      fi
    fi

    local scope="$milestone"
  else
    # Filesystem backend: infer from marker
    if [ -z "$milestone" ]; then
      if [ -s "$MARKER_FILE" ]; then
        milestone=$(tr -d '[:space:]' < "$MARKER_FILE")
      else
        echo "ralph: no active PRD in $MARKER_FILE. Provide explicit scope." >&2
        return 1
      fi
    fi
    scope="$milestone"
  fi

  # Read baseline
  if ! read_baseline "$scope"; then
    echo "ralph: no baseline found in scope '$scope'" >&2
    return 1
  fi

  local baseline_sha="$BASELINE_SHA"
  local baseline_issue="$BASELINE_ISSUE"
  local baseline_branch="$BASELINE_BRANCH"

  # Confirm the issue is still open/ready. Skip when the issue is unknown
  # (fs backend records an empty issue — Claude picks at iteration time).
  if [ -z "$baseline_issue" ]; then
    : # nothing to confirm
  elif [ "$BACKEND" = "github" ]; then
    local repo_flag=""
    [ -n "$GH_REPO" ] && repo_flag="--repo $GH_REPO"
    local issue_state
    # shellcheck disable=SC2086
    issue_state=$(gh issue view "$baseline_issue" $repo_flag --json state -q .state 2>/dev/null)
    if [ "$issue_state" != "OPEN" ]; then
      echo "ralph: warning: issue #$baseline_issue is not OPEN (state: $issue_state)" >&2
    fi
  else
    # Filesystem backend: check if issue file exists and has Status: ready
    local issue_file=".scratch/$scope/issues/${baseline_issue}.md"
    if [ ! -f "$issue_file" ]; then
      echo "ralph: warning: issue file '$issue_file' not found" >&2
    else
      local status
      status=$(grep -m1 '^Status:' "$issue_file" | awk '{print $2}')
      # Redo-from-scratch expects a still-pending issue. 'done' means the
      # work completed — recovering it would redo finished work.
      if [ "$status" != "ready" ]; then
        echo "ralph: warning: issue $baseline_issue has status '$status' (expected ready)" >&2
      fi
    fi
  fi

  # Print the recovery runbook
  echo "Recovery runbook for scope '$scope' (issue #$baseline_issue on branch $baseline_branch):"
  echo
  recovery_plan "$baseline_sha" "$scope" "$baseline_issue" "$baseline_branch"
  echo
  echo "ralph: the 'git push --force-with-lease' step must be run by the human operator."
}

check_main_branch_guard() {
  # Preflight guard: refuse to run when on main/master (or detected default branch)
  # unless overridden via RALPH_ALLOW_MAIN=1. Returns 0 if guard passes, 1 if blocked.
  if [ "${RALPH_ALLOW_MAIN:-0}" = "1" ]; then
    return 0
  fi

  local current_branch
  current_branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null) || {
    echo "ralph: failed to detect current branch" >&2
    return 1
  }

  # Detect default branch: try GitHub API first (if github backend), then fall back to local git
  local default_branch=""
  if [ "$BACKEND" = "github" ]; then
    local repo_flag=""
    [ -n "$GH_REPO" ] && repo_flag="--repo $GH_REPO"
    # shellcheck disable=SC2086
    default_branch=$(gh api $repo_flag repos/:owner/:repo --jq '.default_branch' 2>/dev/null)
  fi

  # Fall back to local git repo detection if GitHub API didn't work or wasn't used
  if [ -z "$default_branch" ]; then
    if git rev-parse --verify main >/dev/null 2>&1; then
      default_branch="main"
    elif git rev-parse --verify master >/dev/null 2>&1; then
      default_branch="master"
    else
      default_branch="main"
    fi
  fi

  if [ "$current_branch" = "$default_branch" ]; then
    echo "ralph: refusing to run on '$default_branch' — create/checkout an engagement branch first" >&2
    echo "  Example: git checkout -b ralph/my-engagement" >&2
    return 1
  fi

  return 0
}

check_clean_tree_guard() {
  # Preflight guard against the false-green-on-restart hazard (ADR-0010, extends ADR-0009).
  # The remote-mode test oracle (ADR-0008 model B) clones origin, so it only
  # sees PUSHED state. If an iteration is interrupted with a dirty tree or
  # unpushed commits and ralph is restarted, the gate would test stale origin
  # and report a false green. Refuse to start an iteration unless the working
  # tree is clean AND HEAD == origin/<branch>, forcing commit+push before the
  # next gate runs. Override with RALPH_ALLOW_DIRTY=1.
  if [ "${RALPH_ALLOW_DIRTY:-0}" = "1" ]; then
    return 0
  fi

  # Not a git repo? Nothing to guard.
  git rev-parse --is-inside-work-tree >/dev/null 2>&1 || return 0

  if [ -n "$(git status --porcelain 2>/dev/null)" ]; then
    echo "ralph: refusing to run — working tree is dirty (uncommitted or untracked changes)" >&2
    echo "  The remote test oracle only sees pushed state, so dirty work would be tested as a false green." >&2
    echo "  Commit + push the work, 'git stash -u' it, or set RALPH_ALLOW_DIRTY=1 to override." >&2
    return 1
  fi

  local current_branch upstream
  current_branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
  upstream="origin/$current_branch"
  if git rev-parse --verify "$upstream" >/dev/null 2>&1; then
    if [ "$(git rev-parse HEAD 2>/dev/null)" != "$(git rev-parse "$upstream" 2>/dev/null)" ]; then
      echo "ralph: refusing to run — HEAD differs from $upstream (unpushed or diverged commits)" >&2
      echo "  The remote test oracle would test stale origin → false green. Push (or reset to) $upstream first," >&2
      echo "  or set RALPH_ALLOW_DIRTY=1 to override." >&2
      return 1
    fi
  fi

  return 0
}

cmd_ls() {
  local arg="${1:-}"
  if [ "$BACKEND" = "github" ]; then
    if [ -n "$arg" ]; then
      ls_issues_gh "$arg"
    else
      ls_milestones
    fi
  else
    if [ -n "$arg" ]; then
      ls_issues_fs "$arg"
    else
      ls_prds
    fi
  fi
}

# --- subcommands ------------------------------------------------------
iterate_once() {
  resolve_agent_cli_config || return 1
  resolve_model_config "$RESOLVED_AGENT_CLI" || return 1

  # Preflight guard: refuse to run on main/default branch
  check_main_branch_guard || return 11
  # Preflight guard: refuse to run with a dirty/unpushed tree (false-green hazard, ADR-0010)
  check_clean_tree_guard || return 12

  local interactive=0
  if [ "${1:-}" = "-i" ]; then interactive=1; shift; fi
  local milestone="${1:-}"
  local prompt
  # Issue picked this iteration, recorded in the baseline. Known up-front for
  # the GitHub backend; empty for fs (Claude picks), where SHA+branch still
  # give recovery its reset target.
  local picked_issue=""
  if [ "$BACKEND" = "github" ]; then
    command -v gh >/dev/null 2>&1 || { echo "ralph: 'gh' CLI not found" >&2; return 1; }
    command -v jq >/dev/null 2>&1 || { echo "ralph: 'jq' not found" >&2; return 1; }

    # Infer milestone if not provided
    if [ -z "$milestone" ]; then
      milestone=$(infer_milestone_gh)
      rc=$?
      if [ $rc -ne 0 ]; then
        return "$rc"
      fi
    fi

    local pick
    pick=$(pick_next_issue_gh "$milestone")
    if [ -z "$pick" ]; then
      if [ "$ALL_BLOCKED" = 1 ]; then
        echo "<promise>BLOCKED</promise>"
        return 21
      fi
      close_milestone_gh "$milestone"
      echo "<promise>COMPLETE</promise>"
      return 20
    fi
    picked_issue="$pick"
    prompt=$(build_prompt_gh "$milestone" "$pick")
  else
    local active prd_dir
    active=$(read_active_marker) || return $?
    prd_dir=".scratch/$active"
    if [ ! -d "$prd_dir" ]; then
      echo "ralph: active PRD '$prd_dir' missing. Stopping." >&2
      return 1
    fi
    prompt=$(build_prompt "$prd_dir" "$prd_dir/issues")
  fi

  local result rc
  if [ "$interactive" = 1 ]; then
    if [ "$RESOLVED_AGENT_CLI" != "claude" ]; then
      echo "ralph: AGENT_CLI=$RESOLVED_AGENT_CLI is configured, but interactive execution is not implemented for this adapter yet" >&2
      return 1
    fi
    # Interactive TUI — no -p, no capture. Promise auto-detection disabled.
    if [ -n "$RESOLVED_MODEL" ]; then
      # shellcheck disable=SC2086
      $RESOLVED_AGENT_CMD $RESOLVED_AGENT_ARGS --model "$RESOLVED_MODEL" --dangerously-skip-permissions "$prompt"
    else
      # shellcheck disable=SC2086
      $RESOLVED_AGENT_CMD $RESOLVED_AGENT_ARGS --dangerously-skip-permissions "$prompt"
    fi
    rc=$?
    if [ $rc -ne 0 ]; then
      echo "ralph: $RESOLVED_AGENT_CLI invocation failed (rc=$rc)" >&2
      return 1
    fi
    return 0
  fi

  # Non-interactive: write JSONL logs, detect promise from the final-message artifact
  command -v jq >/dev/null 2>&1 || { echo "ralph: 'jq' not found" >&2; return 1; }

  local scope
  if [ "$BACKEND" = "github" ]; then
    scope="$milestone"
  else
    scope="${prd_dir:-?}"
  fi

  local logs_dir=".ralph-logs/$scope"
  mkdir -p "$logs_dir" || { echo "ralph: failed to create logs directory" >&2; return 1; }

  # Record the iteration baseline before invoking the agent CLI (both backends).
  record_baseline "$scope" "$picked_issue"

  # Create session marker (PID file) and set up cleanup trap
  local running_file="$logs_dir/running"
  echo "$$" > "$running_file" || { echo "ralph: failed to create running file" >&2; return 1; }
  RALPH_RUNNING_FILE="$running_file"
  trap 'rm -f -- "$RALPH_RUNNING_FILE"' EXIT

  local ts iter_num log_file final_file
  ts=$(date +%s)
  iter_num=$(find "$logs_dir" -maxdepth 1 -type f -name 'iter-*.jsonl' 2>/dev/null | wc -l | awk '{print $1+1}')
  log_file="$logs_dir/iter-${iter_num}-${ts}.jsonl"
  final_file=$(iteration_final_message_file "$log_file")

  # Manifest: announce what this iteration is about to do before the agent streams.
  printf '\n── ralph iteration %s ─────────────────────────────\n' "$iter_num"
  printf '  scope:  %s\n' "$scope"
  printf '  issue:  %s\n' "${picked_issue:-(agent picks)}"
  printf '  agent:  %s\n' "$RESOLVED_AGENT_CLI"
  printf '  model:  %s\n' "$(agent_model_manifest_value)"
  printf '  branch: %s\n' "$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo n/a)"
  printf '  log:    %s\n' "$log_file"
  printf '────────────────────────────────────────────────────\n\n'

  case "$RESOLVED_AGENT_CLI" in
    claude)
      # Stream live text output to terminal while writing raw JSONL to file.
      # shellcheck disable=SC2086
      $RESOLVED_AGENT_CMD $RESOLVED_AGENT_ARGS --output-format stream-json --verbose --effort low --model "$RESOLVED_MODEL" --dangerously-skip-permissions -p "$prompt" 2>&1 \
        | grep --line-buffered '^{' \
        | tee "$log_file" \
        | stream_claude_jsonl_pretty
      rc=${PIPESTATUS[0]}
      ;;
    codex)
      # Use Codex native stdin-prompt mode (`exec -`), JSONL stdout, and native
      # final-message output file so the artifact contract stays adapter-agnostic.
      # shellcheck disable=SC2086
      printf '%s' "$prompt" | $RESOLVED_AGENT_CMD $RESOLVED_AGENT_ARGS exec --json --output-last-message "$final_file" --dangerously-bypass-approvals-and-sandbox --model "$RESOLVED_MODEL" - \
        | tee "$log_file" \
        | stream_codex_jsonl_pretty
      rc=${PIPESTATUS[1]}
      ;;
    pi)
      # Pi's documented JSON mode streams session events to stdout. Keep project
      # inputs enabled in non-interactive mode and avoid persisting provider sessions.
      if [ -n "$RESOLVED_MODEL" ]; then
        # shellcheck disable=SC2086
        $RESOLVED_AGENT_CMD $RESOLVED_AGENT_ARGS --mode json --approve --no-session --model "$RESOLVED_MODEL" "$prompt" 2>&1 \
          | tee "$log_file" \
          | stream_pi_jsonl_pretty
      else
        # shellcheck disable=SC2086
        $RESOLVED_AGENT_CMD $RESOLVED_AGENT_ARGS --mode json --approve --no-session "$prompt" 2>&1 \
          | tee "$log_file" \
          | stream_pi_jsonl_pretty
      fi
      rc=${PIPESTATUS[0]}
      ;;
    *)
      echo "ralph: AGENT_CLI=$RESOLVED_AGENT_CLI is configured, but non-interactive execution is not implemented for this adapter yet" >&2
      return 1
      ;;
  esac
  if [ "$rc" -ne 0 ]; then
    echo "ralph: $RESOLVED_AGENT_CLI invocation failed (rc=$rc)" >&2
    return 1
  fi

  if ! write_final_message_artifact "$RESOLVED_AGENT_CLI" "$log_file" "$final_file"; then
    echo "ralph: failed to write final assistant message artifact" >&2
    return 1
  fi

  # Detect promise from the final-message artifact (legacy JSONL fallback for
  # older logs stays inside the helper).
  result=$(extract_promise_from_iteration_artifacts "$log_file")
  if [ -z "$result" ]; then
    return 0
  fi

  if [ "$result" = "COMPLETE" ]; then
    [ "$BACKEND" = "github" ] && close_milestone_gh "$milestone"
    echo "ralph: scope '$scope' complete."
    return 20
  fi
  if [ "$result" = "BLOCKED" ]; then
    echo "ralph: scope '$scope' blocked. Human needed." >&2
    return 21
  fi
  return 0
}

# Allow sourcing for testing (e.g. `. ralph; pick_next_issue ...`).
(return 0 2>/dev/null) && return 0

[ $# -ge 1 ] || usage

case "$1" in
  status) cmd_status; exit 0 ;;
  kill)   cmd_kill;   exit 0 ;;
  ls)     cmd_ls "${2:-}"; exit $? ;;
  inspect)
    shift
    cmd_inspect "$@"
    exit $?
    ;;
  recover)
    shift
    cmd_recover "${1:-}"
    exit $?
    ;;
  once)
    shift
    iterate_once "$@"
    exit $?
    ;;
  run)
    [ $# -ge 2 ] || usage
    N="$2"
    [[ "$N" =~ ^[0-9]+$ ]] || { echo "ralph: iterations must be a number"; exit 1; }
    for ((i=1; i<=N; i++)); do
      echo "=== ralph iteration $i/$N ==="
      iterate_once "${3:-}"
      rc=$?
      case $rc in
        0)  ;;                            # continue
        20) exit 0 ;;                     # COMPLETE
        21) exit 2 ;;                     # BLOCKED
        10) exit 0 ;;                     # no marker
        11) exit 1 ;;                     # main branch guard
        12) exit 1 ;;                     # dirty/unpushed tree guard
        *)  exit $rc ;;                   # other failure
      esac
    done
    ;;
  -h|--help) usage ;;
  *) usage ;;
esac
